<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulut yedeğine hiçbir şey gitmez (veriler telefonda kalır;
     kullanıcının yedeği uygulamadaki şifreli .krz dosyasıdır). Telefondan
     telefona kabloyla / yakın bağlantıyla aktarım sistemin varsayılanında. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
