<?xml version="1.0" encoding="utf-8"?>
<!-- Şifresiz (http) bağlantı yalnız cihazın kendisine: kullanıcının harita
     paketleri (.mbtiles / .pmtiles / .gpkg) Mapbox'a 127.0.0.1'deki yerel karo
     sunucusundan verilir (lib/data/tiles/local_tile_server.dart). Geri kalan
     bütün bağlantılar https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
