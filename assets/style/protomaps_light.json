{
  "version": 8,
  "name": "Pusula Protomaps Light",
  "sources": {
    "protomaps": { "type": "vector" }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f5f3ee" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": { "fill-color": "#e8e6de" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "paint": { "fill-color": "#dde7d2", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e7e6dd" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": { "fill-color": "#9fc6e0" }
    },
    {
      "id": "roads_casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 7,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d6d0c2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.6, 14, 6, 18, 16]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 3.5, 18, 11]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": { "fill-color": "#e2ded1", "fill-opacity": 0.9 }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9a8fb0",
        "line-width": 1.2,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 4,
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 14, 15]
      },
      "paint": {
        "text-color": "#33312b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    }
  ]
}
