{
  "version": 8,
  "name": "Kerteriz Protomaps Light",
  "sources": {
    "protomaps": { "type": "vector" }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f5f3ee" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": { "fill-color": "#e8e6de" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "paint": { "fill-color": "#dde7d2", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e7e6dd" }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["any", ["==", "kind", "park"], ["==", "kind", "forest"], ["==", "kind", "wood"], ["==", "kind", "grass"], ["==", "kind", "pitch"], ["==", "kind", "garden"]],
      "paint": { "fill-color": "#cfe3c0", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": { "fill-color": "#9fc6e0" }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#9a8fb0",
        "line-width": 1.2,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "roads_casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 7,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#cdc7b8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.8, 14, 7, 18, 18]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 3.5, 18, 12]
      }
    },
    {
      "id": "roads_major",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["any", ["==", "kind", "major_road"], ["==", "kind", "medium_road"]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffe9a8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.0, 14, 4.5, 18, 14]
      }
    },
    {
      "id": "roads_highway",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["==", "kind", "highway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f6b352",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.2, 14, 5.5, 18, 16]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#e2ded1", "fill-opacity": 0.9 }
    },
    {
      "id": "roads_label",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 13]
      },
      "paint": {
        "text-color": "#5a564c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "pois_label",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "pois",
      "minzoom": 14,
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 17, 13],
        "text-anchor": "top",
        "text-offset": [0, 0.4]
      },
      "paint": {
        "text-color": "#2f6b3a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "minzoom": 4,
      "layout": {
        "text-field": ["get", "name"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 14, 16]
      },
      "paint": {
        "text-color": "#33312b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
